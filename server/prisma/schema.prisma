// ─────────────────────────────────────────────────────────────
//  Quick Park · Prisma Schema
//  A Smart Parking Marketplace
//  Enterprise auth architecture: single `Auth` identity table
//  with 1:1 role profiles (`User`, `Provider`) referenced via FK.
//
//  All future modules reference Auth.id — one universal identity.
//  Login credentials live ONLY in `Auth`; never duplicated.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────
enum Role {
  USER
  PROVIDER
  ADMIN // Future ready
}

enum AccountStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum ProviderType {
  HOUSE
  APARTMENT
  COMMERCIAL
  HOTEL
  HOSPITAL
  MALL
  OFFICE
  SCHOOL
}

enum ProviderVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum VehicleType {
  CAR
  BIKE
  SUV
  VAN
  TRUCK
  EV
  OTHER
}

enum ParkingType {
  HOUSE // Individual House
  APARTMENT
  COMMERCIAL // Commercial Parking
  MALL
  HOTEL
  HOSPITAL
  OFFICE
  SCHOOL
  EVENT // Event Parking
}

enum ParkingSurface {
  OPEN
  COVERED
  BASEMENT
  MULTI_LEVEL
}

enum SpaceStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  CARD
  UPI
  CASH
  OTHER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

enum OTPChannel {
  EMAIL
  PHONE
}

// ── Auth (parent — credentials & identity ONLY) ─────────────
model Auth {
  id              String        @id @default(uuid())
  fullName        String
  email           String        @unique @db.VarChar(255)
  phone           String        @unique @db.VarChar(20)
  passwordHash    String
  role            Role          @default(USER)
  isEmailVerified Boolean       @default(false)
  isPhoneVerified Boolean       @default(false)
  accountStatus   AccountStatus @default(ACTIVE)
  profileImage    String?
  lastLogin       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // 1:1 role profiles
  user     User?
  provider Provider?

  // Every module references Auth.id
  vehicles           Vehicle[]
  parkingSpaces      ParkingSpace[]
  bookingsAsUser     Booking[]           @relation("BookingUser")
  bookingsAsProvider Booking[]           @relation("BookingProvider")
  reviewsAsUser      Review[]            @relation("ReviewUser")
  reviewsAsProvider  Review[]            @relation("ReviewProvider")
  favorites          Favorite[]
  notifications      Notification[]
  wallet             Wallet?
  payments           Payment[]
  sessions           Session[]
  otps               OTP[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]

  @@index([role])
  @@index([accountStatus])
  @@index([email])
  @@map("auths")
}

// ── User (driver profile only — 1:1 with Auth) ──────────────
model User {
  id                   String    @id @default(uuid())
  authId               String    @unique
  gender               String?
  dateOfBirth          DateTime?
  address              String?
  emergencyContact     String?
  preferredLanguage    String?
  notificationSettings Json?

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@map("users")
}

// ── Provider (parking owner profile only — 1:1 with Auth) ───
model Provider {
  id                         String                     @id @default(uuid())
  authId                     String                     @unique
  providerType               ProviderType
  businessName               String?
  businessRegistrationNumber String?
  gstNumber                  String?                    @unique
  governmentId               String?
  businessLicense            String?
  verificationStatus         ProviderVerificationStatus @default(PENDING)
  walletBalance              Decimal                    @default(0) @db.Decimal(12, 2)
  rating                     Decimal?                   @db.Decimal(3, 2)
  totalBookings              Int                        @default(0)
  totalRevenue               Decimal                    @default(0) @db.Decimal(12, 2)
  bankAccountName            String?
  bankAccountNumber          String?
  ifscCode                   String?
  upiId                      String?
  address                    String?
  location                   Json?

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([providerType])
  @@index([verificationStatus])
  @@map("providers")
}

// ── Vehicle ─────────────────────────────────────────────────
model Vehicle {
  id        String       @id @default(uuid())
  authId    String
  regNumber String       @unique @db.VarChar(20)
  make      String
  model     String
  color     String?
  type      VehicleType?
  isDefault Boolean      @default(false)
  deletedAt DateTime?

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([deletedAt])
  @@map("vehicles")
}

// ── ParkingSpace ────────────────────────────────────────────
model ParkingSpace {
  id             String         @id @default(uuid())
  authId         String // provider's Auth.id
  parkingName    String
  parkingType    ParkingType    @default(HOUSE)
  description    String?
  // location
  address        String
  area           String?
  landmark       String?
  city           String
  state          String
  country        String         @default("India")
  pincode        String?
  latitude       Float?
  longitude      Float?
  // capacity
  totalCapacity  Int
  availableSlots Int
  slotNumbering  String? // JSON string: ["A1","A2",...]
  vehicleTypes   String[]       @default([]) // ["CAR","BIKE","SUV","EV"]
  surfaceType    ParkingSurface @default(OPEN)
  // pricing
  pricePerHour   Decimal        @db.Decimal(10, 2)
  pricePerDay    Decimal?       @db.Decimal(10, 2)
  pricePerMonth  Decimal?       @db.Decimal(10, 2)
  weekendPricing Json? // { multiplier } or { pricePerHour }
  festivalPricing Json? // { name, multiplier }
  // working hours
  openTime       String? // "09:00"
  closeTime      String? // "21:00"
  open24Hours    Boolean        @default(false)
  availableDays  String[]       @default([]) // ["MONDAY",...]
  // amenities & rules
  amenities      String[]       @default([]) // ["CCTV","SECURITY_GUARD",...]
  rules          Json? // { maxHeight, maxWeight, noOvernight, helmetRequired, noHeavyVehicles, customRules[] }
  // media & documents
  coverImage     String?
  images         String[]       @default([])
  propertyProof  String?
  parkingLicense String?
  // status & metrics
  status         SpaceStatus    @default(DRAFT)
  averageRating  Decimal?       @db.Decimal(3, 2)
  totalBookings  Int            @default(0)
  deletedAt      DateTime?

  auth      Auth       @relation(fields: [authId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([city, state])
  @@index([status])
  @@index([deletedAt])
  @@map("parking_spaces")
}

// ── Booking ─────────────────────────────────────────────────
model Booking {
  id            String        @id @default(uuid())
  userId        String // driver's Auth.id
  providerId    String // provider's Auth.id
  spaceId       String
  startAt       DateTime
  endAt         DateTime
  slotLabel     String?
  status        BookingStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  checkoutToken String?       @unique
  cancelledAt   DateTime?
  deletedAt     DateTime?

  user     Auth         @relation("BookingUser", fields: [userId], references: [id], onDelete: Restrict)
  provider Auth         @relation("BookingProvider", fields: [providerId], references: [id], onDelete: Restrict)
  space    ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  payment Payment?
  review  Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([providerId])
  @@index([spaceId])
  @@index([status])
  @@index([deletedAt])
  @@map("bookings")
}

// ── Payment ─────────────────────────────────────────────────
model Payment {
  id        String        @id @default(uuid())
  bookingId String        @unique
  walletId  String?
  payerId   String?
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CARD)
  status    PaymentStatus @default(PENDING)
  reference String?       @unique
  paidAt    DateTime?
  deletedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  wallet  Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payer   Auth?   @relation(fields: [payerId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([payerId])
  @@index([status])
  @@index([deletedAt])
  @@map("payments")
}

// ── Review ──────────────────────────────────────────────────
model Review {
  id        String    @id @default(uuid())
  bookingId String    @unique
  userId    String // reviewer's Auth.id
  spaceId   String
  rating    Int // 1..5
  comment   String?
  deletedAt DateTime?

  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       Auth         @relation("ReviewUser", fields: [userId], references: [id], onDelete: Restrict)
  space      ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  provider   Auth?        @relation("ReviewProvider", fields: [providerId], references: [id])
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([spaceId])
  @@index([deletedAt])
  @@map("reviews")
}

// ── Favorite ↩ myBookings ──────────────────────────────────
model Favorite {
  id        String    @id @default(uuid())
  authId    String
  spaceId   String
  deletedAt DateTime?

  auth  Auth         @relation(fields: [authId], references: [id], onDelete: Cascade)
  space ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authId, spaceId])
  @@index([deletedAt])
  @@map("favorites")
}

// ── Notification ────────────────────────────────────────────
model Notification {
  id         String    @id @default(uuid())
  receiverId String // receiver's Auth.id
  title      String
  message    String
  type       String    @default("INFO")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  deletedAt  DateTime?

  receiver Auth @relation(fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([receiverId, isRead])
  @@index([deletedAt])
  @@map("notifications")
}

// ── Wallet ─────────────────────────────────────────────────
model Wallet {
  id        String    @id @default(uuid())
  ownerId   String    @unique
  balance   Decimal   @default(0) @db.Decimal(12, 2)
  currency  String    @default("INR")
  deletedAt DateTime?

  owner Auth @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("wallets")
}

// ── Transaction ────────────────────────────────────────────
model Transaction {
  id           String          @id @default(uuid())
  walletId     String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  referenceId  String?
  balanceAfter Decimal         @db.Decimal(12, 2)
  deletedAt    DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([type])
  @@index([deletedAt])
  @@map("transactions")
}

// ── Session (refresh tokens) ───────────────────────────────
model Session {
  id           String    @id @default(uuid())
  authId       String
  refreshToken String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  deletedAt    DateTime?

  auth Auth @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([refreshToken])
  @@index([deletedAt])
  @@map("sessions")
}

// ── OTP ────────────────────────────────────────────────────
model OTP {
  id         String     @id @default(uuid())
  authId     String?
  identifier String
  purpose    OTPPurpose
  codeHash   String
  channel    OTPChannel @default(EMAIL)
  consumedAt DateTime?
  expiresAt  DateTime
  attempts   Int        @default(0)
  deletedAt  DateTime?

  auth Auth? @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([identifier])
  @@index([deletedAt])
  @@map("otps")
}

// ── PasswordReset ───────────────────────────────────────────
model PasswordReset {
  id         String    @id @default(uuid())
  authId     String?
  identifier String // email or phone
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  deletedAt  DateTime?

  auth Auth? @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([identifier])
  @@index([usedAt])
  @@index([deletedAt])
  @@map("password_resets")
}

// ── EmailVerification ───────────────────────────────────────
model EmailVerification {
  id         String    @id @default(uuid())
  authId     String?
  identifier String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  deletedAt  DateTime?

  auth Auth? @relation(fields: [authId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authId])
  @@index([identifier])
  @@map("email_verifications")
}
