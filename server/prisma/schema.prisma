// ─────────────────────────────────────────────────────────────
//  Quick Park · Prisma Schema
//  A Smart Parking Marketplace
//  Production-ready: relations, enums, indexes, constraints,
//  soft-delete, cascade rules and admin-ready roles.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ───────────────────────────────────────────────────
enum Role {
  USER
  PROVIDER
  ADMIN // Future ready
}

enum ProviderType {
  HOUSE
  APARTMENT
  COMMERCIAL
  HOTEL
  HOSPITAL
  MALL
  OFFICE
  SCHOOL
}

enum VehicleType {
  CAR
  BIKE
  SUV
  VAN
  TRUCK
  EV
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  WALLET
  CARD
  UPI
  CASH
  OTHER
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum OTPPurpose {
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

enum OTPChannel {
  EMAIL
  PHONE
}

// ── User ────────────────────────────────────────────────────
model User {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique @db.VarChar(255)
  phone           String    @unique @db.VarChar(20)
  passwordHash    String
  role            Role      @default(USER)
  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  avatar          String?
  gender          String?
  dob             DateTime?
  addressLine     String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  tokenVersion    Int       @default(0)
  lastLoginAt     DateTime?
  deletedAt       DateTime?

  vehicles           Vehicle[]
  favorites          Favorite[]
  bookings           Booking[]
  reviews            Review[]
  notifications      Notification[]
  sessions           Session[]
  otps               OTP[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  wallet             Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isEmailVerified])
  @@index([deletedAt])
  @@map("users")
}

// ── Provider ────────────────────────────────────────────────
model Provider {
  id                 String                     @id @default(cuid())
  ownerName          String
  businessName       String?
  providerType       ProviderType
  email              String                     @unique @db.VarChar(255)
  phone              String                     @unique @db.VarChar(20)
  passwordHash       String
  role               Role                       @default(PROVIDER)
  gstNumber          String?                    @unique
  profilePhoto       String?
  governmentIdUrl    String?
  businessLicenseUrl String?
  isEmailVerified    Boolean                    @default(false)
  isPhoneVerified    Boolean                    @default(false)
  verificationStatus ProviderVerificationStatus @default(PENDING)
  slug               String?                    @unique
  onboardingStep     Int                        @default(0)
  onboardingComplete Boolean                    @default(false)
  bankName           String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankIfsc           String?
  upiId              String?
  lastLoginAt        DateTime?
  deletedAt          DateTime?

  parkingSpaces      ParkingSpace[]
  bookings           Booking[]
  reviews            Review[]
  notifications      Notification[]
  sessions           Session[]
  otps               OTP[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  wallet             Wallet?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([verificationStatus])
  @@index([providerType])
  @@index([deletedAt])
  @@map("providers")
}

enum ProviderVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

// ── Vehicle ─────────────────────────────────────────────────
model Vehicle {
  id        String       @id @default(cuid())
  userId    String
  regNumber String       @unique @db.VarChar(20)
  make      String
  model     String
  color     String?
  type      VehicleType?
  isDefault Boolean      @default(false)
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deletedAt])
  @@map("vehicles")
}

// ── ParkingSpace ────────────────────────────────────────────
model ParkingSpace {
  id             String    @id @default(cuid())
  providerId     String
  title          String
  description    String?
  addressLine    String
  city           String
  state          String
  postalCode     String?
  country        String
  latitude       Float?
  longitude      Float?
  pricePerHour   Decimal   @db.Decimal(10, 2)
  totalSlots     Int
  availableSlots Int
  images         String[]  @default([])
  isActive       Boolean   @default(true)
  isVerified     Boolean   @default(false)
  amenities      String?
  deletedAt      DateTime?

  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  bookings  Booking[]
  reviews   Review[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
  @@index([city, state])
  @@index([isActive])
  @@index([deletedAt])
  @@map("parking_spaces")
}

// ── Booking ─────────────────────────────────────────────────
model Booking {
  id            String        @id @default(cuid())
  userId        String
  providerId    String
  spaceId       String
  startAt       DateTime
  endAt         DateTime
  slotLabel     String?
  status        BookingStatus @default(PENDING)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(PENDING)
  checkoutToken String?       @unique
  cancelledAt   DateTime?
  deletedAt     DateTime?

  user     User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider Provider     @relation(fields: [providerId], references: [id], onDelete: Restrict)
  space    ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  payment Payment?
  review  Review?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([providerId])
  @@index([spaceId])
  @@index([status])
  @@index([deletedAt])
  @@map("bookings")
}

// ── Payment ─────────────────────────────────────────────────
model Payment {
  id        String        @id @default(cuid())
  bookingId String        @unique
  walletId  String?
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod @default(CARD)
  status    PaymentStatus @default(PENDING)
  reference String?       @unique
  paidAt    DateTime?
  deletedAt DateTime?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  wallet  Wallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([status])
  @@index([deletedAt])
  @@map("payments")
}

// ── Review ──────────────────────────────────────────────────
model Review {
  id        String    @id @default(cuid())
  bookingId String    @unique
  userId    String
  spaceId   String
  rating    Int // 1..5
  comment   String?
  deletedAt DateTime?

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  space   ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Provider   Provider? @relation(fields: [providerId], references: [id])
  providerId String?

  @@index([userId])
  @@index([spaceId])
  @@index([deletedAt])
  @@map("reviews")
}

// ── Favorite ↩ myBookings ──────────────────────────────────
model Favorite {
  id        String    @id @default(cuid())
  userId    String
  spaceId   String
  deletedAt DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  space ParkingSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, spaceId])
  @@index([deletedAt])
  @@map("favorites")
}

// ── Notification ────────────────────────────────────────────
model Notification {
  id         String    @id @default(cuid())
  userId     String?
  providerId String?
  title      String
  message    String
  type       String    @default("INFO")
  isRead     Boolean   @default(false)
  readAt     DateTime?
  deletedAt  DateTime?

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead])
  @@index([providerId, isRead])
  @@index([deletedAt])
  @@map("notifications")
}

// ── Wallet ─────────────────────────────────────────────────
model Wallet {
  id         String    @id @default(cuid())
  userId     String?   @unique
  providerId String?   @unique
  balance    Decimal   @default(0) @db.Decimal(12, 2)
  currency   String    @default("INR")
  deletedAt  DateTime?

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  transactions Transaction[]
  payments     Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("wallets")
}

// ── Transaction ────────────────────────────────────────────
model Transaction {
  id           String          @id @default(cuid())
  walletId     String
  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  description  String
  referenceId  String?
  balanceAfter Decimal         @db.Decimal(12, 2)
  deletedAt    DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([type])
  @@index([deletedAt])
  @@map("transactions")
}

// ── Session (refresh tokens) ───────────────────────────────
model Session {
  id           String    @id @default(cuid())
  userId       String?
  providerId   String?
  refreshToken String
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  deletedAt    DateTime?

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([providerId])
  @@index([refreshToken])
  @@index([deletedAt])
  @@map("sessions")
}

// ── OTP ────────────────────────────────────────────────────
model OTP {
  id         String     @id @default(cuid())
  identifier String
  purpose    OTPPurpose
  codeHash   String
  channel    OTPChannel @default(EMAIL)
  consumedAt DateTime?
  expiresAt  DateTime
  attempts   Int        @default(0)
  deletedAt  DateTime?

  userId     String?
  providerId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([deletedAt])
  @@map("otps")
}

// ── PasswordReset ───────────────────────────────────────────
model PasswordReset {
  id         String    @id @default(cuid())
  identifier String // email or phone
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  deletedAt  DateTime?

  userId     String?
  providerId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@index([usedAt])
  @@index([deletedAt])
  @@map("password_resets")
}

// ── EmailVerification ───────────────────────────────────────
model EmailVerification {
  id         String    @id @default(cuid())
  identifier String
  tokenHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  deletedAt  DateTime?

  userId     String?
  providerId String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([identifier])
  @@map("email_verifications")
}
