# ── Quick Park Server ────────────────────────────────
# Runtime
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000/api/v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/quickpark?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_openssl_rand_hex
JWT_REFRESH_SECRET=change_me_refresh_secret_openssl_rand_hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=qp_refresh
REFRESH_COOKIE_SECURE=false

# OTP / Tokens
OTP_EXPIRES_IN_MINUTES=10
EMAIL_VERIFY_EXPIRES_IN=3600
PASSWORD_RESET_EXPIRES_IN=3600
CRYPTO_SECRET=change_me_crypto_secret_32bytes_min

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Quick Park <no-reply@quickpark.app>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=quickpark

# App
RATE_LIMIT_MAX=100
UPLOAD_MAX_BYTES=5242880

# Admin bootstrap (used by `npm run prisma:seed`)
# ADMIN_PHONE is optional — the seed auto-generates a placeholder if omitted.
ADMIN_EMAIL=admin@quickpark.app
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME="Quick Park Admin"
# ADMIN_PHONE=9000000000